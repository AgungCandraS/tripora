# Runtime
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://tripora:tripora@localhost:5432/tripora?schema=public

# Redis (queue + reservation hold cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Auth / JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Payment gateway (Mayar per PRD §41)
PAYMENT_PROVIDER=mayar
PAYMENT_EXPIRY_MINUTES=30
WEB_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=

# Mayar payment gateway (primary)
MAYAR_API_KEY=
MAYAR_API_BASE=https://api.mayar.id
# Token webhook DARI dashboard Mayar (kolom webhook menu Integration).
# Salin ke sini. Kosong = tanpa cek token.
MAYAR_WEBHOOK_TOKEN=
MAYAR_INVOICE_EXPIRY_MINUTES=30
# Demo portofolio tanpa uang asli: simulasi webhook (WAJIB false di production)
MAYAR_SKIP_WEBHOOK_VERIFY=true

# Storage: Cloudinary (cocok untuk Vercel; gratis, CDN). Kosongkan = upload nonaktif.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storage lama (Cloudflare R2) — optional, tidak dipakai bila Cloudinary aktif
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Komisi diatur admin per vendor (/admin/vendors) + fee via /admin/settings.
# Tidak ada commission di env agar histori finansial konsisten.
RESERVATION_HOLD_MINUTES=10

# Anti-fake booking (PRD §32)
MAX_ACTIVE_UNPAID_PER_CONTACT=3
THROTTLE_DEFAULT_LIMIT=120

# Payout (PRD §64)
PAYOUT_MINIMUM=50000

# Kontak publik (dipakai /admin/settings)
SUPPORT_EMAIL=halo@tripora.id

# Worker
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_URL=
